# 复制本文件为 .env 并填写你的密钥（.env 不要提交到 git）

# 必填：大模型 API Key
# DeepSeek 申请：https://platform.deepseek.com  → 在 DeepSeek 控制台新建 API Key
LLM_API_KEY=sk-407e53c9bfa4406a9f3a70b89fac0d6a

# 接口地址（OpenAI 兼容）。以下为各家默认值，按需修改：
#   DeepSeek:  https://api.deepseek.com/v1
#   硅基流动:  https://api.siliconflow.cn/v1        （推荐：免费额度，无需绑卡，有 DeepSeek 同款）
#   通义千问:  https://dashscope.aliyuncs.com/compatible-mode/v1
#   智谱 GLM:  https://open.bigmodel.cn/api/paas/v4
#   OpenAI:    https://api.openai.com/v1
LLM_BASE_URL=https://api.deepseek.com/v1

# 模型名
#   DeepSeek:  deepseek-chat
#   硅基流动:  deepseek-ai/DeepSeek-V3   （或 Qwen/Qwen3-8B 等免费模型）
#   通义千问:  qwen-plus   （或 qwen-max）
#   智谱 GLM:  glm-4-flash （有免费额度）
#   OpenAI:    gpt-4o-mini
LLM_MODEL=deepseek-chat

# 创意度（0~1，越高越发散）。默认 0.9 适合种草文风
LLM_TEMPERATURE=0.9

# 请求超时（毫秒），默认 45 秒
LLM_TIMEOUT=45000

# 本地服务端口
PORT=3000
